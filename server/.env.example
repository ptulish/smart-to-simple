# Получите бесплатный ключ на https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Опционально) Конкретная модель Gemini.
# Если не задано — сервер сам подберёт первую доступную из:
#   gemini-2.5-flash → gemini-2.5-flash-lite → gemini-2.0-flash → gemini-flash-latest
# Посмотреть список доступных вашему ключу: GET http://localhost:3001/api/models
# GEMINI_MODEL=gemini-2.5-flash

# (Опционально) Максимальная длина ответа в токенах. По умолчанию 8192.
# Увеличьте, если ответы обрываются на длинных документах. Потолок Gemini 2.5 — 65536.
# GEMINI_MAX_OUTPUT_TOKENS=16384

# Порт сервера (опционально)
PORT=3001
